/* Colors */
@define-color text #cdd6f4;
@define-color subtext1 #b8c0e0;
@define-color base #24273a;
@define-color mantle #1e2030;
@define-color crust #181926;
@define-color surface0 #363a4f;
@define-color surface1 #494d64;
@define-color surface2 #5b6078;
@define-color overlay0 #6e738d;
@define-color overlay1 #8087a2;
@define-color overlay2 #939ab7;
@define-color text #cad3f5;
@define-color red #ed8796;
@define-color maroon #ee99a0;
@define-color peach #f5a97f;
@define-color green #a6da95;
@define-color teal #8bd5ca;
@define-color blue #8aadf4;
@define-color lavender #b7bdf8;

/* Global */
* {
    border: none;
    font-family: "FiraCode Nerd Font Propo";
    font-weight: bold;
    font-size: 14px;
    min-height: 0;
}

window#waybar {
    background: transparent;
    color: @text;
}

tooltip {
    background: @crust;
    color: @subtext1;
    border-radius: 8px;
    padding: 4px;
}

/* Workspaces */
#workspaces {
    padding: 4px;
    padding-right: 0px;
}

#workspaces button {
    color: @surface1;
    background: @mantle;
    border-radius: 8px;
    margin-right: 4px;
    padding-right: 3px; /* Adjustment for icons */
    padding-left: 0px;
}

#workspaces button:hover {
    color: @blue;
    background: @surface0;
}

#workspaces button.active {
    color: @subtext1;
    box-shadow: inset 0 -1px #1e1e2e;
}

#workspaces button.active.focused {
    color: @blue;
    background: @surface1;
    box-shadow: inset 0 -1px #1e1e2e;
}

#workspaces button.urgent {
    color: @red;
}

/* Module groups */
#web-apps, #workspaces, #clock, #group-right {
    background: @base;
    margin: 8px 4px;
    border-radius: 8px;
    box-shadow: 2px 2px 2px 0px rgba(0, 0, 0, 0.3);
    opacity: 1;
}

#web-apps { margin-left: 10px; }
#group-right { margin-right: 10px; }

/* Module padding */

#clock,
#battery,
#wireplumber,
#pulseaudio,
#network,
#bluetooth,
#idle_inhibitor,
#custom-lock,
#custom-power,
#custom-quit,
#custom-reboot
#web-apps {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
}

#web-apps { padding-left: 8px; padding-right: 12px; }

#clock {
    font-size: 12px;
}

#custom-separator {
    font-weight: normal;
    color: @mantle;
}

#idle_inhibitor { font-size: 10px; padding-right: 12px; }
#custom-quit { padding-right: 6px; }
#custom-lock { padding-right: 12px; padding-top: 0px; }
#custom-reboot { padding-right: 2px; padding-top: 0px; }
#custom-power { padding-right: 12px; }

/* Module colors */
#battery { color: @teal; }
#battery.charging { color: @green; }
#battery.warning:not(.charging) { color: @peach; }
#battery.critical:not(.charging) { color: @red; }

#network { color: @teal; }
#bluetooth { color: @blue; } 
#wireplumber, #pulseaudio.source { color: @lavender; }
#group-power { color: @red; }

#bluetooth.off,
#wireplumber.muted,
#pulseaudio.source-muted {
    color: @maroon;
}

#idle_inhibitor.activated { color: @blue; }

